<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CarNavigationHelper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!-- Launch screen (logo) on all Android versions, follows the system light/dark mode -->
    <style name="Theme.CarNavigationHelper.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CarNavigationHelper</item>
    </style>
</resources>
